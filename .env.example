# ModelMatch AI: Artificial Analysis Free Data API. Never commit the real .env.
# Obtain a key at https://artificialanalysis.ai/data-api/docs
AA_API_KEY=

# Vertex uses existing Google Cloud Application Default Credentials, not a Gemini key.
# Leave project/location blank to reuse the gcloud project and default global location.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
MODELMATCH_VERTEX_MODEL=gemini-3.5-flash
MODELMATCH_RESEARCHER_MODEL=gemini-3.5-flash-lite
MODELMATCH_GROUNDING_MODEL=gemini-3.5-flash

# Optional shell environment setting to suppress LiteLLM remote cost metadata.
# app.py enables the bundled map before importing the model integration.
# LITELLM_LOCAL_MODEL_COST_MAP=True

# Live is the default. Set to 1 only for explicit synthetic, provider-free tests.
MODELMATCH_OFFLINE=0
# Disposable server-side AA cache; never required as a persistent volume.
MODELMATCH_CACHE_DIR=/tmp/modelmatch-aa
